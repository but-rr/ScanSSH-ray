{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "allowJs": true, "checkJs": false, "isolatedModules": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["svelte", "vite/client"]
  },
  "include": ["**/*.ts", "**/*.svelte"]
}
