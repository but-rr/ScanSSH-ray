# Copy to .env next to ScanSSH-ray.exe. Never commit real secrets.
# Use single quotes for Windows paths and values containing #, $, or backslashes.
# Relative paths resolve from the directory containing this file.
SCAN_RANGES='10.0.113.1-21/24,10.0.113.100-120/24,10.32.237.1-25/24,10.0.219.1-20/24'
SSH_USER='admin'
SSH_PORT=22
# Path to an OpenSSH private key. Do not paste the key contents here.
SSH_KEY_PATH=''
SSH_KEY_PASSPHRASE=''
# Optional JSON array; first matching rule wins, then SSH_KEY_PATH.
# Each rule can override user/passphrase as well as the key path.
# SSH_KEY_RULES='[{"match":"10.0.113.*","path":"keys/key_113"},{"match":"10.32.237.1-30","path":"keys/key_237","user":"admin"}]'
SSH_KEY_RULES='[]'
# New server keys are accepted and saved automatically; changed keys are blocked.
SSH_KNOWN_HOSTS='data/known_hosts'
PROXY_HOST='10.0.0.1'
PROXY_PORT=3128
PROXY_AUTH='basic'
PROXY_USER=''
PROXY_PASSWORD=''
TEST_URL='http://www.google.com'
LOCAL_PORT=3128
SSH_INTERVAL_SECONDS=10
INTERNET_INTERVAL_SECONDS=30
CONNECT_TIMEOUT_SECONDS=4
COMMAND_TIMEOUT_SECONDS=10
SCAN_CONCURRENCY=12
AUTO_SCAN=true
