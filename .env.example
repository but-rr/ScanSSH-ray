# Скопируйте в файл .env рядом с ScanSSH-ray.exe.
# Используйте одинарные кавычки для путей Windows и значений, содержащих #, $ или обратные слеши.
# Относительные пути отсчитываются от папки, в которой находится этот файл.
SCAN_RANGES='10.0.113.1-21/24,10.0.113.100-120/24,10.32.237.1-25/24,10.0.219.1-20/24'
SSH_USER='admin'
SSH_PORT=22
# ПУТЬ к закрытому ключу OpenSSH. Не вставляйте сюда содержимое ключа.
SSH_KEY_PATH=''
SSH_KEY_PASSPHRASE=''
# Необязательный JSON-массив правил. Применяется первое совпавшее правило, затем SSH_KEY_PATH.
# Каждое правило может переопределять пользователя, парольную фразу и путь к ключу.
# SSH_KEY_RULES='[{"match":"10.0.113.*","path":"keys/key_113"},{"match":"10.32.237.1-30","path":"keys/key_237","user":"admin"}]'
SSH_KEY_RULES='[]'
# Ключи новых серверов принимаются и сохраняются автоматически; изменённые ключи блокируются.
SSH_KNOWN_HOSTS='data/known_hosts'
PROXY_HOST='10.0.0.1'
PROXY_PORT=3128
PROXY_AUTH='basic'
PROXY_USER=''
PROXY_PASSWORD=''
TEST_URL='http://www.google.com'
LOCAL_PORT=3128
SSH_INTERVAL_SECONDS=10
INTERNET_INTERVAL_SECONDS=30
CONNECT_TIMEOUT_SECONDS=4
COMMAND_TIMEOUT_SECONDS=10
SCAN_CONCURRENCY=12
AUTO_SCAN=true
